/*
 * Default per-process resources. Values are clamped by params.max_* .
 */

process {
    cpus   = { Math.min(1 * task.attempt, params.max_cpus as int) }
    memory = { def m = 4.GB * task.attempt; def x = params.max_memory as nextflow.util.MemoryUnit; m.compareTo(x) == 1 ? x : m }
    time   = { def t = 4.h  * task.attempt; def x = params.max_time   as nextflow.util.Duration;   t.compareTo(x) == 1 ? x : t }

    errorStrategy = { task.exitStatus in [130,137,138,139,140,143,247] ? 'retry' : 'finish' }
    maxRetries    = 1

    withLabel: process_low {
        cpus   = { Math.min(2, params.max_cpus as int) }
        memory = { def m = 4.GB * task.attempt; def x = params.max_memory as nextflow.util.MemoryUnit; m.compareTo(x) == 1 ? x : m }
        time   = { def t = 4.h  * task.attempt; def x = params.max_time   as nextflow.util.Duration;   t.compareTo(x) == 1 ? x : t }
    }
    withLabel: process_medium {
        cpus   = { Math.min(4, params.max_cpus as int) }
        memory = { def m = 12.GB * task.attempt; def x = params.max_memory as nextflow.util.MemoryUnit; m.compareTo(x) == 1 ? x : m }
        time   = { def t = 8.h   * task.attempt; def x = params.max_time   as nextflow.util.Duration;   t.compareTo(x) == 1 ? x : t }
    }
    withLabel: process_high {
        cpus   = { Math.min(8, params.max_cpus as int) }
        memory = { def m = 24.GB * task.attempt; def x = params.max_memory as nextflow.util.MemoryUnit; m.compareTo(x) == 1 ? x : m }
        time   = { def t = 16.h  * task.attempt; def x = params.max_time   as nextflow.util.Duration;   t.compareTo(x) == 1 ? x : t }
    }
}
