/*
 * proseq2.0-nf : Nextflow DSL2 port of the Danko-Lab proseq2.0 pipeline
 * Preprocess & align Run-On sequencing (PRO/GRO/ChRO-seq) data.
 */

manifest {
    name            = 'proseq2.0-nf'
    description     = 'Nextflow DSL2 port of the Danko-Lab proseq2.0 PRO/GRO/ChRO-seq pipeline'
    mainScript      = 'main.nf'
    nextflowVersion = '>=22.10.0'
    version         = '2.0.0-nf'
}

params {
    help         = false

    // ---- Input / output ----
    input        = null            // samplesheet CSV: sample,fastq_1,fastq_2
    outdir       = './results'
    publish_mode = 'copy'

    // ---- Reference genome ----
    bwa_index    = null            // PREFIX of the bwa index (no .bwt suffix)
    chrom_info   = null            // chromInfo table (2-col: chrom<TAB>size)

    // ---- Assay preset (expands the geometry flags below) ----
    assay        = null            // GRO | PRO | ChRO  (sets se_read + rna5/rna3 defaults)

    // ---- Single-end (SE) options ----
    se_read      = null            // RNA_5prime (GRO-seq, -G) | RNA_3prime (PRO-seq, -P)
                                   // default (no assay): RNA_3prime (PRO, -P)

    // ---- Paired-end (PE) options ----
    rna5         = null            // R1_5prime | R2_5prime  (derived from rna3 if null)
    rna3         = null            // R1_5prime | R2_5prime  (default, no assay: R1_5prime = PRO/ChRO)
    map5         = true            // report 5' end (true) or 3' end (false, PE only)
    opposite_strand = false        // report on the opposite strand

    // ---- Adapters ----
    adapter_se   = 'TGGAATTCTCGGGTGCCAAGG'          // SE 3' adapter
    adapter1     = 'GATCGTCGGACTGTAGAACTCTGAACG'    // 3' adapter of R2
    adapter2     = 'AGATCGGAAGAGCACACGTCTGAACTC'    // 3' adapter of R1

    // ---- UMI / barcodes / dedup ----
    umi1              = 0          // UMI length on 5' of R1
    umi2              = 0          // UMI length on 5' of R2
    add_b1            = 0          // extra barcode trimmed from 5' of R1
    add_b2            = 0          // extra barcode trimmed from 5' of R2
    force_deduplicate = false      // dedup even without a UMI

    // ---- Mapping ----
    aligner      = null            // 'aln' | 'mem'  (default: SE->aln, PE->mem)
    dreg         = false           // dREG-compatible params (SE only, uses aln, q0)
    map_length   = 0               // dataset-wide read-length cutoff for mapping (0 = off)

    // ---- QC ----
    skip_fastqc  = false           // FastQC on raw + trimmed reads
    skip_multiqc = false           // aggregate FastQC + cutadapt into one report
    gene_bed     = null            // BED12 gene model; when set, run RSeQC strand inference
                                   // (validate-and-warn against the configured strand flags)
    remove_rrna  = false           // pre-alignment rRNA depletion with SortMeRNA
    rrna_refs    = null            // rRNA reference FASTA(s): comma-separated list or a glob
                                   // (required when --remove_rrna)

    // ---- Resource ceilings ----
    max_cpus     = 8
    max_memory   = '32.GB'
    max_time     = '48.h'
}

// Per-process resource labels
includeConfig 'conf/base.config'

profiles {
    standard   { process.executor = 'local' }
    conda      { conda.enabled = true;      params.enable_conda = true }
    mamba      { conda.enabled = true;      conda.useMamba = true }
    docker     { docker.enabled = true;     docker.runOptions = '-u $(id -u):$(id -g)' }
    singularity{ singularity.enabled = true; singularity.autoMounts = true }
    slurm      { process.executor = 'slurm' }
}

// Reproducible bash: fail on unset vars & errors, but do NOT use pipefail
// (the original script relies on lenient mid-pipe grep exit codes).
process.shell = ['/bin/bash', '-eu']

// Reports
timeline { enabled = true; file = "${params.outdir}/pipeline_info/execution_timeline.html"; overwrite = true }
report   { enabled = true; file = "${params.outdir}/pipeline_info/execution_report.html";   overwrite = true }
trace    { enabled = true; file = "${params.outdir}/pipeline_info/execution_trace.txt";     overwrite = true }
dag      { enabled = true; file = "${params.outdir}/pipeline_info/pipeline_dag.html";       overwrite = true }
